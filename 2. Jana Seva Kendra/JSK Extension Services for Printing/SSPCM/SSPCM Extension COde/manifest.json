{
  "manifest_version": 3,
  "name": "SSPCM",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ssp.postmatric.karnataka.gov.in/*",
        "*://ssp.prematric.karnataka.gov.in/*",
        "*://ssp.karnataka.gov.in/*",
        "*://*.karnataka.gov.in/*",
        "http://localhost/*",
        "http://localhost:8080/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:8080/*",
        "*://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["alert_override.js"],
      "matches": ["*://*.karnataka.gov.in/*"]
    }
  ]
}
